<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tylerlaprade.prune-messages-attachments</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin" exec terminal-tab "$HOME" "${DOTFILES_DIR:-$HOME/Code/dotfiles}/scripts/sync/prune-messages-attachments.sh &gt;&gt; /tmp/prune-messages-attachments.log 2&gt;&amp;1; exit"</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>5</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/prune-messages-attachments.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/prune-messages-attachments.log</string>
</dict>
</plist>
