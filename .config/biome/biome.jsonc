{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": "on",
      "complexity": "on",
      "correctness": "on",
      "nursery": "on",
      "performance": "on",
      "security": "on",
      "style": "on",
      "suspicious": "on"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "correctness": {
            // Qwik-only rule that misreads plain closures; a Qwik project turns it back on.
            "useQwikValidLexicalScope": "off",
            // __dirname and __filename do not exist in ES modules, so using them throws.
            "noGlobalDirnameFilename": "warn",
            // A JSON import without `with { type: "json" }` fails to load in browsers and Node.
            "useJsonImportAttributes": "warn",
            // parseInt without a radix misreads strings with a leading zero or 0x.
            "useParseIntRadix": "warn",
            // Assigning to a React prop mutates state React owns and is lost on the next render.
            "noReactPropAssignments": "warn",
            // Destructuring Solid props reads them once and drops their reactivity.
            "noSolidDestructuredProps": "warn"
          },
          "suspicious": {
            // A comparison or logical expression whose result never changes is a logic bug.
            "noConstantBinaryExpressions": "warn",
            // A variable that is read but never assigned is always undefined.
            "noUnassignedVariables": "warn",
            // A GraphQL field requested twice in one selection is a copy or merge mistake.
            "noDuplicateFields": "warn"
          },
          "nursery": {
            // Function declarations versus arrow functions is pure style.
            "useConsistentFunctionStyle": "off",
            // A leading or trailing underscore on a name is pure style.
            "noDanglingUnderscore": "off",
            // A template literal inside another versus a variable is pure style.
            "noNestedTemplateLiterals": "off",
            // null versus undefined is pure style, and DOM and JSON APIs speak null.
            "noNull": "off",
            // Object() versus {} builds the same object.
            "noObjectConstructor": "off",
            // Which for...of source counts as too complex to read is a style call.
            "noUnreadableForOfExpression": "off",
            // Wrapping an arrow function's body in parentheses is pure style.
            "noUnreadableIife": "off",
            // A switch inside a switch versus a helper is pure style.
            "noNestedSwitch": "off",
            // 1.0 and 1 are the same number.
            "noZeroFractions": "off",
            // 0px and 0 are the same length.
            "noZeroLengthUnit": "off",
            // BigInt(1) and 1n are the same value.
            "useBigintLiterals": "off",
            // An IIFE versus a block for a private scope is pure style.
            "useBlockStatementOverIife": "off",
            // Capitalizing constructor names is a naming convention.
            "useCapitalizedConstructors": "off",
            // Which lightness notation a color uses is pure style.
            "useConsistentLightnessNotation": "off",
            // How a file is read before JSON.parse is pure style.
            "useConsistentJsonFileRead": "off",
            // toContain() versus another matcher for the same check is pure style.
            "useExpectToContain": "off",
            // Iterator.zip() versus indexing several arrays is pure style, and older runtimes lack Iterator.zip.
            "useIteratorZip": "off",
            // The case of a test title's first letter is pure style.
            "useLowercaseTestTitle": "off",
            // Whether a function's own name matches the variable it is assigned to is pure style.
            "useMatchingFunctionName": "off",
            // Math.abs() versus the same comparison written out is pure style.
            "useMathAbs": "off",
            // A named versus an anonymous function expression is pure style.
            "useNamedFunction": "off",
            // Returning a condition versus if/return true/false is pure style.
            "useSimplifiedBooleanReturn": "off",
            // -x versus x * -1 is pure style.
            "useUnaryMinus": "off",
            // Ending a loop in its while condition versus with a break is pure style.
            "useWhileLoopCondition": "off",
            // Like noMagicNumbers, which depth deserves a name is a style call.
            "noMagicArrayFlatDepth": "off",
            // Tailwind class order is pure style.
            "useTailwindSortedClasses": "off",
            // Svelte's shorthand versus long directive syntax is pure style.
            "useSvelteShorthandDirective": "off",
            // Which script and style languages Vue and Svelte blocks use is a project choice.
            "useConsistentBlockLang": "off",
            // Hyphenating Vue event names is pure style.
            "useVueConsistentEventHyphenation": "off",
            // Destructuring Vue props versus reading them off an object is pure style.
            "useVueDefinePropsDestructuring": "off",
            // A Vue component's name versus its file name is a naming convention.
            "useVueMatchingComponentFileName": "off",
            // v-model versus the prop and update: listener it stands for is pure style.
            "useVueVModel": "off"
          },
          "style": {
            // Which literals deserve a name is a style call; drawing coordinates and data tables read best inline.
            "noMagicNumbers": "off",
            // Writing ++ versus += 1 is pure style.
            "noIncrementDecrement": "off",
            // A ternary versus an if/else is pure style.
            "noTernary": "off",
            // Skipping the rest of a loop body with continue versus nesting it is pure style.
            "noContinue": "off",
            // Where exports sit in a file is pure style.
            "useExportsLast": "off",
            // Hex versus rgb(), hsl() or oklch() notation for the same color is pure style.
            "noHexColors": "off",
            // Named versus default exports is a team preference, and plugin and config hosts such as OpenCode require a default export.
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // Test-suite rules key on calls named test, it and describe, so they apply only inside test files.
      "includes": ["**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveNestedTestSuites": "off"
          },
          "nursery": {
            "useValidTestTitle": "off"
          },
          "suspicious": {
            "noDuplicateTestHooks": "off",
            "noExportsInTest": "off",
            "noFocusedTests": "off",
            "noSkippedTests": "off",
            "noIdenticalTestTitle": "off"
          },
          "style": {
            "useConsistentTestIt": "off",
            "useTestHooksInOrder": "off",
            "useTestHooksOnTop": "off"
          },
          "correctness": {
            "usePlaywrightValidDescribeCallback": "off"
          }
        }
      }
    },
    {
      "includes": ["**/tests/**", "**/e2e/**", "**/*.test.*", "**/*.spec.*"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveNestedTestSuites": "on"
          },
          "nursery": {
            "useValidTestTitle": "on"
          },
          "suspicious": {
            "noDuplicateTestHooks": "on",
            "noExportsInTest": "on",
            "noFocusedTests": "on",
            "noSkippedTests": "on",
            "noIdenticalTestTitle": "on"
          },
          "style": {
            "useConsistentTestIt": "on",
            "useTestHooksInOrder": "on",
            "useTestHooksOnTop": "on"
          },
          "correctness": {
            "usePlaywrightValidDescribeCallback": "on"
          }
        }
      }
    },
    {
      "includes": ["**/tests/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            // Tests and scripts run under Node or Bun, so the runtime's builtins are their tools.
            "noNodejsModules": "off"
          },
          "nursery": {
            // Same reason as noNodejsModules, for scripts that run under Bun.
            "noBunModules": "off"
          },
          "suspicious": {
            // Scripts are command-line tools, so console output is their output.
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
