;; Kanata for macOS — first-principles layout
;;
;; KEEP
;;   Caps: tap Esc / hold Ctrl
;;   F1–F12 → media
;;   fn + Backspace family
;;   Space hold → extend (nav only for now — arrows + jump keys)
;;   Kid lock
;;
;; Space timing: require-prior-idle so mid-sentence spaces fire on press
;; (no lag while typing). After a pause, hold Space still opens extend.
;;
;; Numbers: use the real number row for now (no home-row numpad to memorize).
;; Number row while Space held → F1–F12 (intentional; hard to hit by accident).

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  concurrent-tap-hold yes
  chords-v2-min-idle 50
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defvar
  tap-time 180
  hold-time 200
  ;; Mid-stream Space taps immediately if any key was hit within this window.
  ;; Same idea that fixed letter lag for HRM. Pause ~this long before hold-Space.
  prior-idle-spc 400
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  fn   lctl lalt lmet           spc           rmet ralt
)

;; Parent chords (before layers — work even in kid lock)
;;   both-shifts + k → kid lock ON
;;   both-shifts + b → kid lock OFF
(defchordsv2
  (lsft rsft k) (layer-switch kid)  350 all-released ()
  (lsft rsft b) (layer-switch base) 350 all-released ()
)

;; ---------------------------------------------------------------------------
;; Base
;; ---------------------------------------------------------------------------
(deflayer base
  _    brdn brup mctl lpad bldn blup prev pp   next mute vold volu
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @cap _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  @fnh _    _    _              @spc          _    _
)

;; ---------------------------------------------------------------------------
;; Extend (hold Space) — nav only, memorable
;;
;;   h j k l    →  ← ↓ ↑ →     (vim; only while Space held)
;;   y u i o    →  home pgup pgdn end
;;   number row →  F1–F12
;;   media row  →  still media
;;
;; Modifiers stay real: Space+Shift/Option/Cmd + hjkl for select / word / line.
;; No home-row number remap (use the physical number row when not holding Space).
;; ---------------------------------------------------------------------------
(deflayer extend
  _    brdn brup mctl lpad bldn blup prev pp   next mute vold volu
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    _    _    _    _    _    home pgup pgdn end  _    _    _    _
  _    _    _    _    _    _    left down up   rght _    _    _
  lsft _    _    _    _    _    _    _    _    _    _    rsft
  @fnh lctl lalt lmet           _              rmet ralt
)

;; fn held — delete family:
;;   fn+⌫       → forward delete
;;   fn+⌘/⌥+⌫   → delete word forward
(deflayer fnkeys
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    @fdel
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _
)

;; ---------------------------------------------------------------------------
;; Kid lock — typing OK, modifiers dead
;; Enter: Shift+Shift+K    Exit: Shift+Shift+B
;; Full media row kept (volume + brightness + the rest).
;; ---------------------------------------------------------------------------
(deflayer kid
  _    brdn brup mctl lpad bldn blup prev pp   next mute vold volu
  _    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  XX   a    s    d    f    g    h    j    k    l    ;    '    ret
  XX   z    x    c    v    b    n    m    ,    .    /    XX
  XX   XX   XX   XX              spc          XX   XX
)

(defalias
  cap (tap-hold-press $tap-time $hold-time esc lctl)
  ;; prior-idle: while typing, Space taps immediately (no word-boundary lag).
  ;; After ~prior-idle-spc ms quiet, hold Space still enters extend.
  spc (tap-hold $tap-time $hold-time spc (layer-while-held extend)
      (require-prior-idle $prior-idle-spc))
  fnh (layer-while-held fnkeys)
  fdel (switch
    ((or lmet rmet lalt ralt)) A-del break
    () del break
  )
)
