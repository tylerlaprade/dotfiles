;; Kanata configuration for macOS with hold/tap remappings
;; Bilateral home-row mods: hold only activates with opposite-hand keys

(defcfg
  process-unmapped-keys yes
  ;; danger-enable-cmd yes
  log-layer-changes yes
  concurrent-tap-hold yes
  ;; Grab only the real keyboard. The VirtualHID device is kanata's *output*
  ;; path (via Karabiner DriverKit); grabbing it creates a no-op/feedback loop.
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

;; Hand map for bilateral HRM. Keys not listed are "unknown-hand"
;; (default: ignore — don't force tap/hold from them).
(defhands
  (left
    q w e r t
    a s d f g
    z x c v b
    1 2 3 4 5
  )
  (right
    y u i o p
    h j k l ;
    n m , . /
    6 7 8 9 0
    - = [ ] \ '
  )
)

(defvar
  ;; HRM hold decision timeout (ms). At ~100 WPM keystroke spacing is ~100–120ms;
  ;; we do NOT promote to hold just because the next key is opposite-hand.
  hold-time-hrm 220

  ;; If any key was pressed within this many ms before the HRM key, force TAP.
  ;; Continuous typing almost always has recent activity; intentional mods
  ;; need a brief pause first (~prior-idle gap).
  prior-idle-hrm 160

  ;; Thumb / caps — not bilateral
  tap-time-primary 200
  hold-time-primary 250
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  fn   lctl lalt lmet           spc           rmet ralt
)

;; lmet/rmet passthrough: Monologue double-tap Cmd
(deflayer base
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @cap @a   @s   @d   @f   _    _    @j   @k   @l   @scl _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              @spc          _    @rat
)

(deflayer extend
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  _    _    _
  @cap @ea  @es  @ed  @ef  5    left @ej  @ek  @el  @escl del  _
  _    6    7    8    9    0    home pgdn pgup end  _    _
  _    _    _    _              _              _    @rat
)

(defalias
  ;; Caps / thumbs
  cap (tap-hold-press $tap-time-primary $hold-time-primary esc lctl)
  rat (tap-hold-press $tap-time-primary $hold-time-primary bspc ralt)
  spc (tap-hold $tap-time-primary $hold-time-primary spc (layer-while-held extend))

  ;; ========== Bilateral home-row mods (fast-typist tuned) ==========
  ;; Why plain opposite-hand still ate "fi" in "definition":
  ;;   f (left/Cmd) was still down when i (right) landed → treated as Cmd+i.
  ;; Fix:
  ;;   opposite-hand-release — hold only if the *other* key is pressed AND
  ;;     released while the HRM key is still held (intentional chord).
  ;;     Typing digraphs release the first key first → tap.
  ;;   require-prior-idle — mid-stream typing has recent key activity → force tap.
  ;; Left: Ctrl Shift Alt Cmd
  a (tap-hold-opposite-hand-release $hold-time-hrm a lctl
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  s (tap-hold-opposite-hand-release $hold-time-hrm s lsft
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  d (tap-hold-opposite-hand-release $hold-time-hrm d lalt
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  f (tap-hold-opposite-hand-release $hold-time-hrm f lmet
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))

  ;; Right: Cmd Alt Shift Ctrl
  j (tap-hold-opposite-hand-release $hold-time-hrm j rmet
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  k (tap-hold-opposite-hand-release $hold-time-hrm k ralt
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  l (tap-hold-opposite-hand-release $hold-time-hrm l rsft
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  scl (tap-hold-opposite-hand-release $hold-time-hrm ; rctl
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))

  ;; Extend-layer HRMs (same rules)
  ea (tap-hold-opposite-hand-release $hold-time-hrm 1 lctl
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  es (tap-hold-opposite-hand-release $hold-time-hrm 2 lsft
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  ed (tap-hold-opposite-hand-release $hold-time-hrm 3 lalt
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  ef (tap-hold-opposite-hand-release $hold-time-hrm 4 lmet
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))

  ej (tap-hold-opposite-hand-release $hold-time-hrm left rmet
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  ek (tap-hold-opposite-hand-release $hold-time-hrm down ralt
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  el (tap-hold-opposite-hand-release $hold-time-hrm up rsft
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
  escl (tap-hold-opposite-hand-release $hold-time-hrm rght rctl
      (same-hand tap)
      (timeout hold)
      (require-prior-idle $prior-idle-hrm))
)

