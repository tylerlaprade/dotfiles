;; Kanata for macOS — first-principles layout
;;
;; KEEP
;;   Caps: tap Esc / hold Ctrl
;;   F1–F12 → media
;;   Hold fn → delete family (native fn is not reliable through VirtualHID)
;;   Tap fn  → send fn (input-source / Globe if macOS accepts it)
;;   Space hold → extend (nav: hjkl arrows + jump keys)
;;   Kid lock: both shifts held, then K on / B off
;;
;; Space timing: require-prior-idle so mid-sentence spaces fire on press.
;;
;; Kid lock uses switch on K / B — NOT defchordsv2. Chords buffer every
;; participating key after idle. Here K and B type normally unless both
;; shifts are already held as real inputs.

(defcfg
  process-unmapped-keys yes
  ;; Temporary: log layer changes so kid lock ON/OFF is visible in kanata.out.log
  log-layer-changes yes
  concurrent-tap-hold yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defvar
  tap-time 180
  hold-time 200
  prior-idle-spc 400
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  fn   lctl lalt lmet           spc           rmet ralt
)

;; One-shot layer change + Mouse Keys toggle (Option ×5).
;; release-key first so Option taps are not Shift+Option while both shifts
;; are still held for the trigger.
;; Requires: Accessibility → Pointer Control →
;;   "Press the Option key five times to toggle Mouse Keys".
(defvirtualkeys
  vk-kid  (multi
            (release-key lsft)
            (release-key rsft)
            (layer-switch kid)
            (macro 120 lalt 70 lalt 70 lalt 70 lalt 70 lalt))
  vk-base (multi
            (release-key lsft)
            (release-key rsft)
            (layer-switch base)
            (macro 120 lalt 70 lalt 70 lalt 70 lalt 70 lalt))
)

;; ---------------------------------------------------------------------------
;; Base
;; ---------------------------------------------------------------------------
(deflayer base
  _    brdn brup mctl lpad bldn blup prev pp   next mute vold volu
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @cap _    _    _    _    _    _    _    @kk  _    _    _    _
  _    _    _    _    _    @kb  _    _    _    _    _    _
  @fnh _    _    _              @spc          _    _
)

;; ---------------------------------------------------------------------------
;; Extend (hold Space) — nav only
;;   h j k l → ← ↓ ↑ →
;;   y u i o → home pgup pgdn end
;;   number row → F1–F12
;;   Modifiers real for Shift/Option/Cmd + arrows
;; ---------------------------------------------------------------------------
(deflayer extend
  _    brdn brup mctl lpad bldn blup prev pp   next mute vold volu
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    _    _    _    _    _    home pgup pgdn end  _    _    _    _
  _    _    _    _    _    _    left down up   rght _    _    _
  lsft _    _    _    _    _    _    _    _    _    _    rsft
  @fnh lctl lalt lmet           _              rmet ralt
)

;; Hold fn — delete family
;;   fn+⌫       → forward delete
;;   fn+⌘/⌥+⌫   → delete word forward
(deflayer fnkeys
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    @fdel
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _
)

;; ---------------------------------------------------------------------------
;; Kid lock — letters/numbers OK, modifiers dead, full media row OK
;; Unlock still works: @kb sees real physical shifts via (input real …)
;; even though layer maps lsft/rsft to XX.
;; ---------------------------------------------------------------------------
(deflayer kid
  _    brdn brup mctl lpad bldn blup prev pp   next mute vold volu
  _    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  XX   a    s    d    f    g    h    j    @kk  l    ;    '    ret
  XX   z    x    c    v    @kb  n    m    ,    .    /    XX
  XX   XX   XX   XX              spc          XX   XX
)

(defalias
  cap (tap-hold-press $tap-time $hold-time esc lctl)
  spc (tap-hold $tap-time $hold-time spc (layer-while-held extend)
      (require-prior-idle $prior-idle-spc))
  ;; Tap: pass fn through. Hold: delete layer (the path that works).
  fnh (tap-hold $tap-time $hold-time fn (layer-while-held fnkeys))
  fdel (switch
    ((or lmet rmet lalt ralt)) A-del break
    () del break
  )
  ;; Both shifts already held → kid on/off. Otherwise type k / b as normal.
  ;; (input real …) = physical keys, so this works on the kid layer too.
  kk (switch
    ((and (input real lsft) (input real rsft))) (on-press tap-vkey vk-kid) break
    () k break
  )
  kb (switch
    ((and (input real lsft) (input real rsft))) (on-press tap-vkey vk-base) break
    () b break
  )
)
