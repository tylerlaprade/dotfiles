{
  "extends": "../../.config/basedpyright/pyrightconfig.json",
  "include": ["scripts", "tests"],
  "pythonVersion": "3.14",
  // The 3.9 files run on Apple's /usr/bin/python3: macOS Automation and App Data grants are tied to
  // the interpreter path, and Homebrew's changes on every upgrade.
  "executionEnvironments": [
    { "root": "scripts/setup/apply-macos-defaults.py", "pythonVersion": "3.9" },
    { "root": "scripts/sync/sync-browser-local-state.py", "pythonVersion": "3.9", "extraPaths": ["scripts/sync"] },
    { "root": "scripts/sync/sync-graphite.py", "pythonVersion": "3.9", "extraPaths": ["scripts/sync"] },
    { "root": "scripts/sync/sync-macos-defaults.py", "pythonVersion": "3.9", "extraPaths": ["scripts/sync"] },
    { "root": "scripts/sync/threeway.py", "pythonVersion": "3.9" },
    { "root": "scripts/sync" }
  ]
}
