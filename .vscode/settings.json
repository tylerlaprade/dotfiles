{
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"diffEditor.ignoreTrimWhitespace": false,
		// "editor.autoClosingBrackets": "never",
		"editor.fontFamily": "Cascadia Code, Liga ComicShannsMono Nerd Font"
	},
	"[csharp]": {
		"editor.defaultFormatter": "csharpier.csharpier-vscode"
	},
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer",
		"editor.fontFamily": "Kelmscott Mono, Victor Mono, Liga Comic Mono, Liga ComicShannsMono Nerd Font"
	},
	"[javascript][typescript][javascriptreact][typescriptreact][json][jsonc][css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascript][typescript][javascriptreact][typescriptreact]": {
		"editor.fontFamily": "Menlo"
	},
	"[json][jsonc][jsonl][scss][css]": {
		"editor.fontFamily": "OpenDyslexic Nerd Font, Cascadia Code, Menlo",
		"breadcrumbs.showArrays": true,
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[shellscript]": {
		"editor.defaultFormatter": "foxundermoon.shell-format",
		"editor.fontFamily": "Ubuntu Mono Ligaturized"
	},
	"[toml]": {
		"editor.defaultFormatter": "tamasfe.even-better-toml"
	},
	"editor.fontFamily": "Miracode, Victor Mono, Ubuntu Mono Ligaturized, Victor Mono, LigaSrc Pro, Monaspace Argon Var, Menlo",
	// "editor.fontLigatures": "'calt', 'liga', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09'",
	// I only want some stylistics for Victor Mono and Menlo
	"editor.fontLigatures": "'calt', 'ss01', 'ss07', 'ss08'",
	"errorLens.fontFamily": "Arial",
	"errorLens.fontSize": "14",
	"errorLens.messageTemplate": "[$source]($code) $message (+$count)",
	"errorLens.gutterIconsEnabled": true,
	"gitlens.codeLens.enabled": false,
	"gitlens.blame.ignoreWhitespace": true,
	"gitlens.blame.fontFamily": "Arial",
	"gitlens.currentLine.fontFamily": "Arial",
	"gitlens.currentLine.fontSize": 14,
	"terminal.integrated.fontSize": 20,
	"terminal.integrated.fontFamily": "TamzenForPowerline, Ubuntu Mono Ligaturized",
	"editor.fontSize": 18,
	"markdown.preview.fontSize": 18,
	"editor.inlineSuggest.fontFamily": "Cascadia Code, Menlo",
	"omnisharp.enableEditorConfigSupport": true,
	"dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "fullSolution",
	"editor.codeActionsOnSave": [
		// "source.addMissingImports", // This is dangerous because you might accidentally import from the wrong library
		"source.sortPackageJson",
		// "source.organizeImports", // This seems to conflict with Biome and Ruff
		"source.fixAll"
		// "source.sortMembers", // TODO: what does this do?
	],
	"editor.unicodeHighlight.includeStrings": false,
	"eslint.codeAction.disableRuleComment": {
		"enable": false
	},
	"eslint.lintTask.enable": true,
	"eslint.onIgnoredFiles": "warn",
	"eslint.useESLintClass": true,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"files.autoSave": "afterDelay",
	"files.insertFinalNewline": false,
	"files.trimFinalNewlines": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"githubPullRequests.pullBranch": "never",
	"javascript.autoClosingTags": false,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"typescript.updateImportsOnFileMove.enabled": "always",
	"jestrunner.preserveEditorFocus": true,
	"jestTestExplorer.debugOutput": "externalTerminal",
	"python.analysis.autoImportCompletions": true,
	"python.analysis.inlayHints.functionReturnTypes": true,
	"python.terminal.activateEnvInCurrentTerminal": true,
	"security.workspace.trust.untrustedFiles": "open",
	"python.analysis.addImport.exactMatchOnly": true,
	"fixAllJson.enableFixes": {
		"fixDoubleQuotes": false
	},
	"diffEditor.codeLens": true,
	"githubPullRequests.createOnPublishBranch": "ask",
	"code-runner.saveFileBeforeRun": true,
	"abracadabra.changeSignature.showInQuickFix": false,
	"abracadabra.toggleBraces.showInQuickFix": false,
	"task.allowAutomaticTasks": "on",
	"window.closeWhenEmpty": true,
	"window.title": "${dirty}[VS CODE] ${rootName}${separator}${profileName}${separator}${activeEditorShort}",
	"stylelint.reportDescriptionlessDisables": true,
	"stylelint.reportInvalidScopeDisables": true,
	"stylelint.reportNeedlessDisables": true,
	"stylelint.validate": [
		"css",
		"scss"
	],
	"python.analysis.autoFormatStrings": true,
	"cSpell.validateDirectives": true,
	"window.nativeTabs": true,
	"testExplorer.useNativeTesting": true,
	"editor.gotoLocation.alternativeDeclarationCommand": "editor.action.referenceSearch.trigger",
	"editor.gotoLocation.alternativeDefinitionCommand": "editor.action.referenceSearch.trigger",
	"editor.gotoLocation.alternativeTypeDefinitionCommand": "editor.action.referenceSearch.trigger",
	"editor.gotoLocation.multipleDefinitions": "goto",
	"material-icon-theme.activeIconPack": "react_redux",
	"editor.semanticHighlighting.enabled": true,
	"editor.tokenColorCustomizations": {
		"[*Light*]": {
			"textMateRules": [
				{
					"scope": "ref.matchtext",
					"settings": {
						"foreground": "#000"
					}
				}
			]
		},
		"[*Dark*]": {
			"textMateRules": [
				{
					"scope": "ref.matchtext",
					"settings": {
						"foreground": "#fff"
					}
				}
			]
		},
		"[Quiet Light]": {},
		"textMateRules": []
	},
	"vscodeReactRefactor.babelPlugins": "objectRestSpread, classProperties, typescript, jsx, tsx",
	"githubPullRequests.pushBranch": "always",
	"editor.guides.bracketPairs": "active",
	"python.analysis.inlayHints.pytestParameters": true,
	// "editor.inlayHints.padding": true,
	"ruff.codeAction.disableRuleComment": {
		"enable": false
	},
	"git.openRepositoryInParentFolders": "never",
	"redhat.telemetry.enabled": false,
	// "peacock.surpriseMeOnStartup": true, // This only sets it once per workspace.
	"yaml.schemas": {
		"https://docs.sourcery.ai/resources/sourcery_yaml_schema.json": ".sourcery.yaml"
	},
	"window.autoDetectColorScheme": true,
	"settingsSync.ignoredSettings": [
		"workbench.colorTheme"
	],
	"workbench.preferredLightColorTheme": "Quiet Light",
	"python.analysis.fixAll": [
		"source.convertImportFormat"
	],
	"cSpell.autoFormatConfigFile": true,
	"debug.console.acceptSuggestionOnEnter": "on",
	"files.autoSaveDelay": 500,
	"python.testing.pytestEnabled": true,
	"python.testing.unittestArgs": [],
	"git.autoStash": true,
	"git.closeDiffOnOperation": true,
	"git.timeline.showUncommitted": true,
	"git.showPushSuccessNotification": true,
	"git.pullBeforeCheckout": true,
	"git.mergeEditor": true,
	"git.fetchOnPull": true,
	"git.autofetch": "all",
	"tabnine.experimentalAutoImports": true,
	"svelte.enable-ts-plugin": true,
	"discord.detailsEditing": "Editing a {LANG} file",
	"discord.detailsDebugging": "Debugging a {LANG} file",
	"discord.lowerDetailsEditing": "Ln {current_line}/{total_lines}, Col {current_column}",
	"discord.removeRemoteRepository": true,
	"discord.lowerDetailsNoWorkspaceFound": "Ln {current_line}/{total_lines}, Col {current_column}",
	"discord.lowerDetailsDebugging": "Ln {current_line}/{total_lines}, Col {current_column}",
	"files.hotExit": "onExitAndWindowClose",
	"sql-formatter.dialect": "postgresql",
	"sql-formatter.uppercase": true,
	"[sql]": {
		"editor.defaultFormatter": "lea21st.vscode-sql-formatter"
	},
	"git.alwaysSignOff": true,
	"diffEditor.experimental.showMoves": true,
	"rust-analyzer.semanticHighlighting.punctuation.enable": true,
	"rust-analyzer.semanticHighlighting.operator.specialization.enable": true,
	"rust-analyzer.semanticHighlighting.punctuation.specialization.enable": true,
	"rust-analyzer.inlayHints.typeHints.hideNamedConstructor": true,
	// "rust-analyzer.check.overrideCommand": [
	//   "cargo",
	//   "clippy",
	//   "--fix",
	//   "--workspace",
	//   "--message-format=json",
	//   "--all-targets",
	//   "--allow-dirty"
	// ],
	"cSpell.ignorePaths": [
		"package-lock.json",
		"node_modules",
		"vscode-extension",
		".git/objects",
		".vscode",
		".vscode-insiders",
		"package.json"
	],
	"sourcery.codeLens": false,
	"vim.startInInsertMode": true,
	"editor.quickSuggestionsDelay": 0,
	"vim.overrideCopy": false,
	"html.autoClosingTags": false,
	"svelte.plugin.html.tagComplete.enable": false,
	"editor.inlineSuggest.suppressSuggestions": true,
	"editor.suggestSelection": "recentlyUsedByPrefix",
	"editor.suggest.shareSuggestSelections": true,
	"editor.suggest.localityBonus": true,
	"js/ts.implicitProjectConfig.target": "ESNext",
	"typescript.preferences.preferTypeOnlyAutoImports": true,
	"js/ts.implicitProjectConfig.checkJs": true,
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.test.ts, ${capture}.shared.test.ts",
		"*.tsx": "${capture}.test.tsx, ${capture}.shared.test.ts"
	},
	"explorer.incrementalNaming": "smart",
	"editor.minimap.enabled": false,
	"editor.linkedEditing": true,
	"editor.acceptSuggestionOnCommitCharacter": false,
	"vim.statusBarColorControl": true,
	"githubPullRequests.focusedMode": "multiDiff",
  "editor.cursorSurroundingLines": 17,
	"terminal.integrated.cursorBlinking": true,
	"files.exclude": {
		"**/node_modules": true
	},
	"aws.telemetry": false,
	"aws.codeWhisperer.shareCodeWhispererContentWithAWS": false,
	"indenticator.showCurrentDepthInStatusBar": false,
	"advancedNewFile.convenienceOptions": [
		"current",
		"last",
		"root"
	],
	"reactSnippets.settings.importReactOnTop": false,
	"terminal.integrated.enableMultiLinePasteWarning": "never",
	"zenMode.hideLineNumbers": false,
	"zenMode.centerLayout": false,
	"zenMode.showTabs": "none",
